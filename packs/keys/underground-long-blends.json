     "f"
    ],
    "label": "Filter down",
    "run": "action deck @ filter -0.6"
   },
   {
    "keys": [
     "u",
     "F"
    ],
    "label": "Filter open",
    "run": "action deck @ filter 0"
   },
   {
    "keys": [
